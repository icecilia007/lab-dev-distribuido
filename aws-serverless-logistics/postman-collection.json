	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    console.log('Login successful, response headers:', pm.response.headers);",
									"    ",
									"    // Try to get token from multiple header locations",
									"    const authHeader = pm.response.headers.get('Authorization');",
									"    const remappedHeader = pm.response.headers.get('x-amzn-Remapped-Authorization');",
									"    const xAuthHeader = pm.response.headers.get('x-amzn-remapped-authorization');",
									"    ",
									"    console.log('Authorization header:', authHeader);",
									"    console.log('x-amzn-Remapped-Authorization header:', remappedHeader);",
									"    console.log('x-amzn-remapped-authorization header:', xAuthHeader);",
									"    ",
									"    const tokenHeader = authHeader || remappedHeader || xAuthHeader;",
									"    ",
									"    if (tokenHeader && tokenHeader.startsWith('Bearer ')) {",
									"        const token = tokenHeader.substring(7);",
									"        pm.environment.set('authToken', token);",
									"        pm.globals.set('authToken', token);",
									"        pm.collectionVariables.set('authToken', token);",
									"        console.log('✅ Token saved from header:', token.substring(0, 50) + '...');",
									"    } else {",
									"        // Fallback: try to get token from response body if it contains one",
									"        try {",
									"            const responseJson = pm.response.json();",
									"            if (responseJson.token) {",
									"                const token = responseJson.token;",
									"                pm.environment.set('authToken', token);",
									"                pm.globals.set('authToken', token);",
									"                pm.collectionVariables.set('authToken', token);",
									"                console.log('✅ Token saved from body:', token.substring(0, 50) + '...');",
									"            } else {",
									"                console.log('❌ No token found in response body or headers');",
									"                console.log('Response body:', JSON.stringify(responseJson, null, 2));",
									"            }",
									"        } catch (e) {",
									"            console.log('❌ Error parsing response:', e.message);",
									"        }",
									"    }",
									"} else {",
									"    console.log('❌ Login failed with status:', pm.response.code);",
									"    console.log('Response:', pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"ari@gmail.com\",\n    \"senha\": \"123456\"\n}"
						},
						"url": {
