{
	"info": {
		"name": "Debug Login",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://tntpd380l5.execute-api.us-east-1.amazonaws.com/prod/api"
		}
	],
	"item": [
		{
			"name": "Debug Login - Mostra Tudo",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"console.log('=== RESPONSE DEBUG ===');",
							"console.log('Status:', pm.response.code);",
							"console.log('Status Text:', pm.response.status);",
							"",
							"console.log('=== ALL HEADERS ===');",
							"pm.response.headers.each(function(header) {",
							"    console.log(header.key + ': ' + header.value);",
							"});",
							"",
							"console.log('=== BODY ===');",
							"console.log(pm.response.text());",
							"",
							"console.log('=== LOOKING FOR TOKEN ===');",
							"const authHeader = pm.response.headers.get('Authorization');",
							"if (authHeader) {",
							"    console.log('✅ Authorization header found:', authHeader);",
							"    if (authHeader.startsWith('Bearer ')) {",
							"        const token = authHeader.substring(7);",
							"        console.log('✅ Token extracted:', token.substring(0, 50) + '...');",
							"        console.log('📋 COPY THIS TOKEN:', token);",
							"    }",
							"} else {",
							"    console.log('❌ No Authorization header found');",
							"}",
							"",
							"console.log('=== END DEBUG ===');"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"ari@gmail.com\",\n    \"senha\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["auth", "login"]
				}
			}
		}
	]
}